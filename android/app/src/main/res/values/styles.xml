<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="AppTheme.Base" />
    <style name="PlatformTheme" parent="android:style/Theme.Material.Light.NoActionBar" />
    <style name="AppTheme.Base" parent="PlatformTheme">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:colorControlHighlight">@color/brand_ripple</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">#0E1420</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:textColorPrimary">@color/brand_text</item>
        <item name="android:textColorSecondary">@color/brand_muted</item>
        <item name="android:textColorHint">@color/brand_muted</item>
        <item name="android:buttonStyle">@style/Brand.Button</item>
        <item name="android:editTextStyle">@style/Brand.Input</item>
        <item name="android:spinnerStyle">@style/Brand.Spinner</item>
        <item name="android:checkboxStyle">@style/Brand.CheckBox</item>
        <item name="android:radioButtonStyle">@style/Brand.RadioButton</item>
        <item name="android:dialogTheme">@style/Brand.Dialog</item>
        <item name="android:alertDialogTheme">@style/Brand.Dialog</item>
    </style>
    <style name="Brand.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/brand_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/brand_control_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Brand.Input" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/brand_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textColorHint">@color/brand_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Brand.Spinner" parent="android:style/Widget.Material.Spinner">
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Brand.CheckBox" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Brand.RadioButton" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Brand.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="android:textColorPrimary">@color/brand_text</item>
        <item name="android:textColorSecondary">@color/brand_muted</item>
    </style>
</resources>
