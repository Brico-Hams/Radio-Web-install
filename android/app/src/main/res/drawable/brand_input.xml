<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/brand_surface" />
            <stroke android:width="2dp" android:color="@color/brand_accent" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/brand_surface" />
            <stroke android:width="1dp" android:color="@color/brand_outline" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
