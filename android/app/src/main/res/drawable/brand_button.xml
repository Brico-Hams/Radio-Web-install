<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button for every theme Button: surface fill, 2dp strong border, distinct states. Mirrors BrandUi.buttonLook(SECONDARY). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_disabled_fill" />
            <stroke android:width="2dp" android:color="@color/brand_disabled_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="3dp" android:color="@color/brand_focus" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/brand_surface" />
                    <stroke android:width="2dp" android:color="@color/brand_border_strong" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_secondary_pressed" />
            <stroke android:width="2dp" android:color="@color/brand_border_strong" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_secondary_hover" />
            <stroke android:width="2dp" android:color="@color/brand_border_strong" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_surface" />
            <stroke android:width="2dp" android:color="@color/brand_border_strong" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
