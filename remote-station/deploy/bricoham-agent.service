[Unit]
Description=BricoHam headless station agent
After=network.target

[Service]
Type=simple
User=bricoham
Group=bricoham
EnvironmentFile=/etc/bricoham/agent.env
ExecStart=/usr/bin/python3 /opt/bricoham/bricoham-station-agent.pyz
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
