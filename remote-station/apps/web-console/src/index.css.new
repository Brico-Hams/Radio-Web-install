/* scratch */
:root {
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  color-scheme: light;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;

  /* BricoHams colour manual v1.1: brand */
  --brand-ink: #23272B;
  --brand-orange: #F26B1D;
  --on-accent: #23272B;

  /* Theme tokens (light) */
  --bg: #FFFFFF;
  --surface: #F6F7F8;
  --text: #23272B;
  --text-muted: #59636B;
  --border: #DCE1E5;
  --link: #AA410B;
  --focus: #F26B1D;

  /* Control and status tokens derived from the palette above */
  --control-border: var(--text-muted);
  --primary-hover: #FFA06A;
  --danger: #B42318;
  --danger-hover: #912018;
  --danger-active: #7A140D;
  --on-danger: #FFFFFF;
  --danger-border: #7A140D;
  --danger-bg: #FFF5F4;
  --danger-fg: #8D2925;
  --danger-line: #F0C3C0;
  --warn-bg: #FFF5D9;
  --warn-fg: #6B4F12;
  --warn-line: #E5D09C;
  --green: #1B5E20;

  /* Legacy aliases used across App.css */
  --navy: var(--text);
  --blue: var(--link);
  --muted: var(--text-muted);
  --line: var(--border);
  --mono: "Cascadia Code", Consolas, monospace;

  /* Spacing scale 4/8/12/16/24/32 */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-6: 24px;
  --space-8: 32px;
  --touch-target: 48px;

  color: var(--text);
  background: var(--bg);
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #111518;
  --surface: #1C2329;
  --text: #F6F8FA;
  --text-muted: #BAC4CC;
  --border: #38434C;
  --link: #FFA06A;
  --focus: #FFC18F;
  --primary-hover: #FFC18F;
  --danger-border: #FFB4AB;
  --danger-bg: #2A1614;
  --danger-fg: #FFB4AB;
  --danger-line: #7A140D;
  --warn-bg: #2A2210;
  --warn-fg: #F2D58A;
  --warn-line: #6B4F12;
  --green: #66BB6A;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #111518;
    --surface: #1C2329;
    --text: #F6F8FA;
    --text-muted: #BAC4CC;
    --border: #38434C;
    --link: #FFA06A;
    --focus: #FFC18F;
    --primary-hover: #FFC18F;
    --danger-border: #FFB4AB;
    --danger-bg: #2A1614;
    --danger-fg: #FFB4AB;
    --danger-line: #7A140D;
    --warn-bg: #2A2210;
    --warn-fg: #F2D58A;
    --warn-line: #6B4F12;
    --green: #66BB6A;
  }
}

* {
  box-sizing: border-box;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  overflow-x: hidden;
  font-size: 16px;
  line-height: 1.5;
}

a {
  color: var(--link);
}

img,
svg {
  max-width: 100%;
}

/*
 * Shared button system. Every state sets --btn-* variables; the base rule
 * paints them. Variants: secondary (default for any button), .button-primary,
 * .button-danger and selected (aria-pressed / aria-current / .is-selected).
 */
:where(button, .button, .text-button, .operation-shortcuts a, .help-toc a) {
  --btn-bg: var(--surface);
  --btn-fg: var(--text);
  --btn-border: var(--control-border);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  padding: var(--space-2) var(--space-4);
  border: 2px solid var(--btn-border);
  border-radius: 12px;
  color: var(--btn-fg);
  background: var(--btn-bg);
  cursor: pointer;
  font: inherit;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  text-decoration: none;
  white-space: normal;
  overflow-wrap: anywhere;
  transition: background-color 120ms ease, border-color 120ms ease;
}

:where(button, .button, .text-button, .operation-shortcuts a, .help-toc a):where(:hover:not(:disabled)) {
  --btn-bg: var(--bg);
  --btn-border: var(--text);
}

:where(button, .button, .text-button, .operation-shortcuts a, .help-toc a):where(:active:not(:disabled)) {
  --btn-bg: var(--border);
  --btn-border: var(--text);
  transform: translateY(1px);
}

.button-primary {
  --btn-bg: var(--brand-orange);
  --btn-fg: var(--on-accent);
  --btn-border: var(--brand-ink);
}

.button-primary:hover:not(:disabled) {
  --btn-bg: var(--primary-hover);
  --btn-fg: var(--on-accent);
  --btn-border: var(--brand-ink);
}

.button-primary:active:not(:disabled) {
  --btn-bg: var(--brand-orange);
  --btn-fg: var(--on-accent);
  --btn-border: var(--brand-ink);
  box-shadow: inset 0 4px 0 rgba(35, 39, 43, 0.35);
}

.button-danger {
  --btn-bg: var(--danger);
  --btn-fg: var(--on-danger);
  --btn-border: var(--danger-border);
}

.button-danger:hover:not(:disabled) {
  --btn-bg: var(--danger-hover);
  --btn-fg: var(--on-danger);
  --btn-border: var(--danger-border);
}

.button-danger:active:not(:disabled) {
  --btn-bg: var(--danger-active);
  --btn-fg: var(--on-danger);
  --btn-border: var(--danger-border);
}

/* Selected: solid orange plus a check mark and an inset bar, never colour alone */
button[aria-pressed="true"],
.button[aria-pressed="true"],
.button[aria-current="page"],
.button.is-selected {
  --btn-bg: var(--brand-orange);
  --btn-fg: var(--on-accent);
  --btn-border: var(--brand-ink);
  font-weight: 800;
  box-shadow: inset 0 -6px 0 var(--brand-ink);
}

button[aria-pressed="true"]::before,
.button[aria-current="page"]::before,
.button.is-selected::before {
  content: "\2713";
  font-weight: 800;
}

button[aria-pressed="true"]:hover:not(:disabled),
.button[aria-pressed="true"]:hover:not(:disabled),
.button[aria-current="page"]:hover:not(:disabled),
.button.is-selected:hover:not(:disabled) {
  --btn-bg: var(--primary-hover);
  --btn-fg: var(--on-accent);
  --btn-border: var(--brand-ink);
}

button[aria-pressed="true"]:active:not(:disabled),
.button[aria-pressed="true"]:active:not(:disabled),
.button[aria-current="page"]:active:not(:disabled),
.button.is-selected:active:not(:disabled) {
  --btn-bg: var(--brand-orange);
  --btn-fg: var(--on-accent);
  --btn-border: var(--brand-ink);
}

/* Disabled stays readable (muted text, dashed border) and never looks pressable */
button:disabled,
.button:disabled,
.button-primary:disabled,
.button-danger:disabled {
  --btn-bg: var(--bg);
  --btn-fg: var(--text-muted);
  --btn-border: var(--text-muted);
  border-style: dashed;
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
}

/* The PTT control is the largest button on screen and shows TX while held */
.button-ptt {
  position: sticky;
  bottom: var(--space-4);
  width: 100%;
  min-height: 72px;
  margin: var(--space-4) 0;
  font-size: 20px;
  font-weight: 800;
}

.button-ptt.is-transmitting::before {
  content: "\25CF  TX \00B7  ";
}

.session-actions,
.workspace-navigation,
.help-toc,
.operation-shortcuts {
  gap: var(--space-3);
}

input:not([type="checkbox"]):not([type="range"]),
select {
  min-height: var(--touch-target);
  border: 2px solid var(--control-border);
  border-radius: 12px;
  color: var(--text);
  background: var(--bg);
  font: inherit;
  font-size: 16px;
}

input[type="checkbox"] {
  width: 24px;
  height: 24px;
  accent-color: var(--brand-orange);
}

input[type="range"] {
  min-height: var(--touch-target);
  accent-color: var(--brand-orange);
}

label:has(> input[type="checkbox"]) {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-height: var(--touch-target);
}

button:focus-visible,
a:focus-visible,
summary:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}

summary {
  min-height: var(--touch-target);
  cursor: pointer;
}

::selection {
  color: var(--on-accent);
  background: var(--brand-orange);
}

h1, h2, h3 { font-family: Montserrat, Inter, "Segoe UI", system-ui, sans-serif; }
