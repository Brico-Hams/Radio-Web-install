{
  "format": "radicodex-radio-settings-catalog",
  "version": 1,
  "comment": "Classification rules shared by Node, Python and Android. Every command or range lives in its cited source; nothing here is invented. Radios without a sourced settings protocol are listed with 0 settings and 'pendiente de fuente'.",
  "exclusions": [
    {"id": "tx-region", "match": "MAX POWER|REGION|BAND LIMIT|TX BAND|EMERGENCY FREQ|TX INHIBIT", "scope": "tx", "reason": "REGION/LIMITES TX: maximum power (every MAX POWER item, e.g. EX030503/EX030504), region or TX band limits are never written remotely.", "source": "docs/FTX1-KNOWLEDGE.md (REGION/LIMITES TX, EX table)"},
    {"id": "tx-safety", "match": "^(TX TIME OUT TIMER|RPTT SELECT)$", "scope": "tx", "reason": "Changes the TX time-out or the PTT keying route: weakens TX safety, local operation only.", "source": "docs/FTX1-KNOWLEDGE.md; ftx1-menu.js"},
    {"id": "link-serial", "match": "^(CAT[- ]?\\d*\\b|.*\\b(BAUD ?RATE|RATE|STOP BIT|TIME OUT TIMER|PORT SELECT|TUN/LIN|USB)\\b)", "scope": "link", "reason": "Serial/CAT speed, stop bits, CAT timeout or USB / TUN-LIN port role would cut the remote link.", "source": "docs/FTX1-KNOWLEDGE.md (EX table, ESCRIBE EN LA RADIO)"},
    {"id": "auto-off", "match": "^AUTO POWER OFF$", "scope": "link", "reason": "Powers the radio off and cuts the remote link.", "source": "ftx1-menu.js (EX040107)"},
    {"id": "calibration-reset", "match": "CALIB|RESET|FACTORY|FIRMWARE|BOOT|FORMAT|INITIAL|VERSION|UPDATE", "scope": "maintenance", "reason": "Calibration, reset, firmware or bootloader item: never written remotely.", "source": "docs/FTX1-KNOWLEDGE.md (CALIBRACION)"}
  ],
  "excludedKeys": {"EX030503": "tx-region", "EX030504": "tx-region"},
  "pendingNames": ["OS", "RPT SHIFT", "SPEED UNIT", "WIND UNIT", "RF/SQL VR", "MOD SOURCE", "MIC", "FM DIAL STEP", "DTMF", "ANT2"],
  "pendingKeys": ["EX020203", "EX010322"],
  "pendingReason": "pendiente de fuente: docs/FTX1-KNOWLEDGE.md flags range or length errata for this item.",
  "families": {
    "ftx1-menu": {"mode": "cat-menu", "live": ["node", "python"], "link": "CAT Yaesu newCAT (EX menu) 38400 8N1", "source": "ftx1-menu.js (CAT Operation Reference Manual, Table 3); ftx1-core.js menuReadCommand/menuWriteCommand; docs/FTX1-KNOWLEDGE.md"},
    "ic7300-civ": {"mode": "cat-dedicated", "link": "CI-V USB 19200 (addr 0x94)", "source": "remote-station/bricoham_remote_station/drivers/icom_civ.py (14 0A RF power, 1C 01 tuner)",
      "settings": [{"id": "ic7300.rf-power", "label": "RF power", "type": "number", "min": 0, "max": 255, "unit": "CAT position", "read": "14 0A", "readOnlyReason": "Dedicated config-gated control (--radio-settings-config)."}]},
    "yaesu-newcat-read": {"mode": "cat-read", "link": "CAT Yaesu newCAT USB 38400", "source": "remote-station/bricoham_remote_station/drivers/yaesu_cat.py",
      "settings": [
        {"id": "yaesu.power", "label": "Power", "type": "number", "read": "PC;"},
        {"id": "yaesu.tuner", "label": "Tuner", "type": "number", "read": "AC;"},
        {"id": "yaesu.keyer-speed", "label": "Keyer speed", "type": "number", "read": "KS;"},
        {"id": "yaesu.key-pitch", "label": "Key pitch", "type": "number", "read": "KP;"},
        {"id": "yaesu.keyer", "label": "Keyer", "type": "number", "read": "KR;"},
        {"id": "yaesu.break-in", "label": "Break-in", "type": "number", "read": "BI;"}
      ]},
