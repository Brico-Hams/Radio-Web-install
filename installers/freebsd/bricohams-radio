#!/bin/sh
set -eu

app_dir=/usr/local/libexec/bricohams-radio-workspace/app
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/bricohams-radio
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) < 22)' >/dev/null 2>&1; then
  printf '%s\n' "Bricohams Radio Workspace requiere Node.js 22 o superior." >&2
  exit 1
fi
mkdir -p "$state_dir"
if ! sockstat -4 -l | grep -q '127.0.0.1:8787'; then
  nohup node "$app_dir/server.cjs" >>"$state_dir/server.log" 2>&1 </dev/null &
  attempt=0
  until sockstat -4 -l | grep -q '127.0.0.1:8787'; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 20 ]; then
      printf 'No se pudo iniciar el servidor. Revisa %s/server.log\n' "$state_dir" >&2
      exit 1
    fi
    sleep 0.25
  done
fi

if command -v xdg-open >/dev/null 2>&1; then
  if ! xdg-open http://127.0.0.1:8787; then
    printf '%s\n' "No se pudo abrir el navegador. Visita http://127.0.0.1:8787" >&2
  fi
else
  printf '%s\n' "Abre http://127.0.0.1:8787 en Chromium o en tu navegador."
fi
