#!/bin/sh
set -eu

# Headless "Super Station" launcher (Raspberry Pi): rigctld supervisor + remote agent, no browser.
install_root=${RADICODEX_INSTALL_ROOT:-}
if [ -z "$install_root" ]; then
  for candidate in /opt/radicodex /usr/local/libexec/radicodex; do
    if [ -f "$candidate/app/remote-station.cjs" ]; then install_root=$candidate; break; fi
  done
fi
if [ -z "$install_root" ] || [ ! -f "$install_root/app/remote-station.cjs" ]; then
  printf '%s\n' "No se encuentra la instalacion de RadiCodex. Reinstala el paquete." >&2
  exit 1
fi
node_bin=$install_root/runtime/node/bin/node
if [ ! -x "$node_bin" ]; then
  node_bin=$(command -v node || true)
fi
if [ -z "$node_bin" ] || ! "$node_bin" -e 'process.exit(Number(process.versions.node.split(".")[0]) < 22 ? 1 : 0)' >/dev/null 2>&1; then
  printf '%s\n' "RadiCodex requiere Node.js 22 o superior." >&2
  exit 1
fi
exec "$node_bin" "$install_root/app/remote-station.cjs" --headless "$@"
